{
  "compilerOptions": {
    // File Layout — index.ts is in the root, not ./src
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "strict": true,

    // Recommended Options
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
